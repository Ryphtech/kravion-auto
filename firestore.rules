rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Products (Accessories & Parts catalog) - Full public read, Admin create/modify/delete
    match /products/{productId} {
      allow read, write: if true;
    }

    // Product Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Vehicle Directory & Chassis compatibility
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Homepage Hero Carousel Posters
    match /posters/{posterId} {
      allow read, write: if true;
    }

    // Store Settings & WhatsApp Concierge Configuration
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // Customer Order Enquiries & Wishlists
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Fallback for all other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
